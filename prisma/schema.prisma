// Schéma Prisma 7 pour Personal GEST TRACKER
// La configuration des URLs de connexion pour Migrate est déportée dans prisma.config.ts

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum TransactionType {
  INCOME
  EXPENSE
}

model Transaction {
  id        String          @id @default(uuid())
  type      TransactionType
  amount    Decimal         @db.Decimal(12, 2)
  category  String
  payment   String
  note      String?
  date      DateTime        @default(now())

  // Prévu pour l'authentification Supabase (Sprint 8)
  userId    String?         @map("user_id")

  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  @@index([date(sort: Desc)])
  @@index([type])
  @@index([category])
  @@index([payment])
  @@index([date, type])
  @@index([userId])
  @@map("transactions")
}

model Budget {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  category  String
  amount    Decimal  @db.Decimal(12, 2)
  month     String   // Format YYYY-MM (ex: "2026-10")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, category, month])
  @@index([userId, month])
  @@map("budgets")
}

enum RecurrenceFrequency {
  MONTHLY
  WEEKLY
  YEARLY
}

model RecurringRule {
  id                 String              @id @default(uuid())
  userId             String              @map("user_id")
  type               TransactionType
  amount             Decimal             @db.Decimal(12, 2)
  category           String
  payment            String
  dayOfMonth         Int                 @map("day_of_month") // Jour de l'échéance (1 à 31)
  frequency          RecurrenceFrequency @default(MONTHLY)
  note               String?
  isActive           Boolean             @default(true) @map("is_active")
  lastProcessedMonth String?             @map("last_processed_month") // Dernier mois validé ou ignoré (ex: "2026-10")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  @@index([userId, isActive])
  @@map("recurring_rules")
}


