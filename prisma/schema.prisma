// Schéma Prisma 7 pour Personal GEST TRACKER
// La configuration des URLs de connexion pour Migrate est déportée dans prisma.config.ts

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum WalletType {
  CASH
  MOBILE_MONEY
  BANK
  SAVINGS
}

enum CategoryKind {
  INCOME
  EXPENSE
  BOTH
}

model Category {
  id         String       @id @default(uuid())
  userId     String       @map("user_id")
  name       String
  kind       CategoryKind
  color      String
  isArchived Boolean      @default(false) @map("is_archived")
  systemKey  String?      @map("system_key")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  transactions   Transaction[]
  budgets        Budget[]
  recurringRules RecurringRule[]

  @@unique([userId, name])
  @@unique([userId, systemKey])
  @@index([userId, kind])
  @@index([userId])
  @@map("categories")
}

model Transaction {
  id             String          @id @default(uuid())
  type           TransactionType
  amount         Decimal         @db.Decimal(12, 2)
  category       String
  payment        String
  note           String?
  date           DateTime        @default(now())

  // Catégorie reliée (Optionnelle pour expand/contract)
  categoryId     String?         @map("category_id")
  categoryRel    Category?       @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  // Authentification Supabase
  userId         String?         @map("user_id")

  // Portefeuille source
  walletId       String?         @map("wallet_id")
  wallet         Wallet?         @relation("SourceWallet", fields: [walletId], references: [id], onDelete: SetNull)

  // Portefeuille cible (pour les virements TRANSFER)
  targetWalletId String?         @map("target_wallet_id")
  targetWallet   Wallet?         @relation("TargetWallet", fields: [targetWalletId], references: [id], onDelete: SetNull)

  // Frais de virement et liaison (Sprint 2.10.0)
  linkedTransferId String?         @unique @map("linked_transfer_id")
  feePercent       Decimal?        @map("fee_percent") @db.Decimal(5, 2)
  linkedTransfer   Transaction?    @relation("TransferFees", fields: [linkedTransferId], references: [id], onDelete: Cascade)
  linkedFee        Transaction?    @relation("TransferFees")

  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@index([date(sort: Desc)])
  @@index([type])
  @@index([category])
  @@index([categoryId])
  @@index([payment])
  @@index([date, type])
  @@index([userId])
  @@index([userId, date(sort: Desc), id])
  @@index([walletId])
  @@index([linkedTransferId])
  @@map("transactions")
}

model Wallet {
  id                 String          @id @default(uuid())
  userId             String          @map("user_id")
  name               String          // Ex: "Mon Wave", "Cash Portefeuille", "Compte BOA"
  type               WalletType
  initialBalance     Decimal         @default(0) @map("initial_balance") @db.Decimal(12, 2)
  declaredBalance    Decimal?        @map("declared_balance") @db.Decimal(12, 2)
  declaredAt         DateTime?       @map("declared_at")
  color              String          @default("#2563EB")
  isDefault          Boolean         @default(false) @map("is_default")
  isArchived         Boolean         @default(false) @map("is_archived")
  deletedAt          DateTime?       @map("deleted_at")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  transactionsSource Transaction[]   @relation("SourceWallet")
  transactionsTarget Transaction[]   @relation("TargetWallet")
  recurringRules     RecurringRule[]

  @@index([userId])
  @@index([userId, isArchived])
  @@index([userId, deletedAt])
  @@map("wallets")
}

model Budget {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  category    String
  categoryId  String?   @map("category_id")
  categoryRel Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  amount      Decimal   @db.Decimal(12, 2)
  month       String    // Format YYYY-MM (ex: "2026-10")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([userId, category, month])
  @@index([userId, month])
  @@index([categoryId])
  @@map("budgets")
}

enum RecurrenceFrequency {
  MONTHLY
  WEEKLY
  YEARLY
}

model RecurringRule {
  id                 String              @id @default(uuid())
  userId             String              @map("user_id")
  type               TransactionType
  amount             Decimal             @db.Decimal(12, 2)
  category           String
  categoryId         String?             @map("category_id")
  categoryRel        Category?           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  payment            String
  walletId           String?             @map("wallet_id")
  wallet             Wallet?             @relation(fields: [walletId], references: [id], onDelete: Restrict)
  dayOfMonth         Int                 @map("day_of_month") // Jour de l'échéance (1 à 31)
  frequency          RecurrenceFrequency @default(MONTHLY)
  note               String?
  isActive           Boolean             @default(true) @map("is_active")
  remindersEnabled   Boolean             @default(true) @map("reminders_enabled")
  lastProcessedMonth String?             @map("last_processed_month") // Dernier mois validé ou ignoré (ex: "2026-10")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  reminderLogs       RecurringReminderLog[]

  @@index([userId, isActive])
  @@index([categoryId])
  @@index([walletId])
  @@index([userId, walletId])
  @@map("recurring_rules")
}

model RecurringReminderLog {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  ruleId     String    @map("rule_id")
  dueDate    DateTime  @map("due_date") @db.Date
  offsetDays Int       @map("offset_days") // 7, 3 ou 0
  status     String    // SENT | FAILED
  attempts   Int       @default(0)
  sentAt     DateTime? @map("sent_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  rule       RecurringRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, dueDate, offsetDays])
  @@index([userId])
  @@index([status])
  @@map("recurring_reminder_logs")
}

enum DebtType {
  LENT      // Argent prêté
  BORROWED  // Argent emprunté
}

enum DebtStatus {
  PENDING
  PARTIAL
  SETTLED
}

model Debt {
  id              String      @id @default(uuid())
  userId          String      @map("user_id")
  personName      String      @map("person_name")
  type            DebtType
  initialAmount   Decimal     @map("initial_amount") @db.Decimal(12, 2)
  remainingAmount Decimal     @map("remaining_amount") @db.Decimal(12, 2)
  dueDate         DateTime?   @map("due_date")
  status          DebtStatus  @default(PENDING)
  note            String?
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  @@index([userId, status])
  @@map("debts")
}



