// Schéma Prisma 7 pour Personal GEST TRACKER
// La configuration des URLs de connexion pour Migrate est déportée dans prisma.config.ts

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum WalletType {
  CASH
  MOBILE_MONEY
  BANK
  SAVINGS
}

model Transaction {
  id             String          @id @default(uuid())
  type           TransactionType
  amount         Decimal         @db.Decimal(12, 2)
  category       String
  payment        String
  note           String?
  date           DateTime        @default(now())

  // Authentification Supabase
  userId         String?         @map("user_id")

  // Portefeuille source
  walletId       String?         @map("wallet_id")
  wallet         Wallet?         @relation("SourceWallet", fields: [walletId], references: [id], onDelete: SetNull)

  // Portefeuille cible (pour les virements TRANSFER)
  targetWalletId String?         @map("target_wallet_id")
  targetWallet   Wallet?         @relation("TargetWallet", fields: [targetWalletId], references: [id], onDelete: SetNull)

  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@index([date(sort: Desc)])
  @@index([type])
  @@index([category])
  @@index([payment])
  @@index([date, type])
  @@index([userId])
  @@index([walletId])
  @@map("transactions")
}

model Wallet {
  id                 String          @id @default(uuid())
  userId             String          @map("user_id")
  name               String          // Ex: "Mon Wave", "Cash Portefeuille", "Compte BOA"
  type               WalletType
  initialBalance     Decimal         @default(0) @map("initial_balance") @db.Decimal(12, 2)
  color              String          @default("#2563EB")
  isDefault          Boolean         @default(false) @map("is_default")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  transactionsSource Transaction[]   @relation("SourceWallet")
  transactionsTarget Transaction[]   @relation("TargetWallet")

  @@index([userId])
  @@map("wallets")
}

model Budget {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  category  String
  amount    Decimal  @db.Decimal(12, 2)
  month     String   // Format YYYY-MM (ex: "2026-10")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, category, month])
  @@index([userId, month])
  @@map("budgets")
}

enum RecurrenceFrequency {
  MONTHLY
  WEEKLY
  YEARLY
}

model RecurringRule {
  id                 String              @id @default(uuid())
  userId             String              @map("user_id")
  type               TransactionType
  amount             Decimal             @db.Decimal(12, 2)
  category           String
  payment            String
  dayOfMonth         Int                 @map("day_of_month") // Jour de l'échéance (1 à 31)
  frequency          RecurrenceFrequency @default(MONTHLY)
  note               String?
  isActive           Boolean             @default(true) @map("is_active")
  lastProcessedMonth String?             @map("last_processed_month") // Dernier mois validé ou ignoré (ex: "2026-10")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  @@index([userId, isActive])
  @@map("recurring_rules")
}

enum DebtType {
  LENT      // Argent prêté
  BORROWED  // Argent emprunté
}

enum DebtStatus {
  PENDING
  PARTIAL
  SETTLED
}

model Debt {
  id              String      @id @default(uuid())
  userId          String      @map("user_id")
  personName      String      @map("person_name")
  type            DebtType
  initialAmount   Decimal     @map("initial_amount") @db.Decimal(12, 2)
  remainingAmount Decimal     @map("remaining_amount") @db.Decimal(12, 2)
  dueDate         DateTime?   @map("due_date")
  status          DebtStatus  @default(PENDING)
  note            String?
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  @@index([userId, status])
  @@map("debts")
}



